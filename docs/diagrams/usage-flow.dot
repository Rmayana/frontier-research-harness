digraph Usage {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.6"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontcolor="#1e293b", fontsize=22, width=2.5, height=0.85, penwidth=1.3];
  edge [dir=both, color="#64748b", penwidth=1.6, arrowsize=0.85];
  interface [label="인터페이스", fillcolor="#f8fafc", color="#94a3b8"];
  harness [label="하네스", fillcolor="#effaf5", color="#8fd1b8"];
  model [label="모델", fillcolor="#f3f4f6", color="#94a3b8"];
  interface -> harness;
  harness -> model;
}
