{
  "Name": "HarnessExerciseSmoke",
  "Description": "Short generic exercise and recovery scenario for verifying the Pulse execution boundary.",
  "PatientConfiguration": { "PatientFile": "StandardMale.json" },
  "DataRequestManager": {
    "DataRequest": [
      { "DecimalFormat": { "Precision": 2 }, "Category": "Physiology", "PropertyName": "HeartRate", "Unit": "1/min" },
      { "DecimalFormat": { "Precision": 2 }, "Category": "Physiology", "PropertyName": "OxygenConsumptionRate", "Unit": "mL/min" },
      { "DecimalFormat": { "Precision": 2 }, "Category": "Physiology", "PropertyName": "TotalMetabolicRate", "Unit": "W" },
      { "DecimalFormat": { "Precision": 3 }, "Category": "Physiology", "PropertyName": "AchievedExerciseLevel", "Unit": "unitless" }
    ]
  },
  "AnyAction": [
    {
      "AdvanceTime": {
        "Time": { "ScalarTime": { "Value": 10.0, "Unit": "s" } }
      }
    },
    {
      "PatientAction": {
        "Exercise": { "Intensity": { "Scalar0To1": { "Value": 0.25 } } }
      }
    },
    {
      "AdvanceTime": {
        "Time": { "ScalarTime": { "Value": 30.0, "Unit": "s" } }
      }
    },
    {
      "PatientAction": {
        "Exercise": { "Intensity": { "Scalar0To1": {} } }
      }
    },
    {
      "AdvanceTime": {
        "Time": { "ScalarTime": { "Value": 20.0, "Unit": "s" } }
      }
    }
  ]
}
