digraph Harness {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.45", fontname="Noto Sans CJK KR"];
  node [fontname="Noto Sans CJK KR", fontcolor="#1e293b"];
  edge [color="#64748b", penwidth=1.5, arrowsize=0.8, dir=both];
  external [shape=plain, label=<
    <TABLE BORDER="1" COLOR="#8fd1b8" BGCOLOR="#effaf5" CELLBORDER="0" CELLSPACING="12" CELLPADDING="0" STYLE="ROUNDED">
      <TR><TD COLSPAN="2" CELLPADDING="8"><FONT POINT-SIZE="24"><B>외부 하네스 (직접 설계)</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748b">영역별 도구·프레임워크 후보 · 채택 전</FONT></TD></TR>
      <TR><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>워크플로 제어</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">LangGraph · Temporal</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">Prefect · Dagster</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">직접 구현: Python 등</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>다중 에이전트</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">LangGraph · Pydantic AI · CrewAI</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">Microsoft Agent Framework</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">자체 Orchestrator</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD></TR>
<TR><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>도구 통합</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">규격: MCP · OpenAPI</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">FastMCP · 공식 MCP SDK</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">FastAPI · Python 함수</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>상태 및 기억</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">SQLite · PostgreSQL · Redis</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">pgvector · Qdrant</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">LlamaIndex · Haystack</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD></TR>
<TR><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>검증</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">pytest · Hypothesis</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">Pydantic · JSON Schema</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">응답 평가: promptfoo · DeepEval</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD><TD><TABLE BORDER="1" COLOR="#d8e3e8" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" WIDTH="360" STYLE="ROUNDED"><TR><TD WIDTH="360" HEIGHT="40" ALIGN="CENTER"><FONT POINT-SIZE="20"><B>모니터링</B></FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">LangSmith · Langfuse</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">OpenTelemetry</FONT></TD></TR><TR><TD WIDTH="360" ALIGN="CENTER"><FONT POINT-SIZE="15" COLOR="#475569">Phoenix · MLflow</FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE></TD></TR>
    </TABLE>
  >];
  bridge [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#94a3b8", fontsize=20, width=10.5, height=0.8, label="Codex SDK / App Server / CLI"];
  core [shape=box, style="rounded,filled", fillcolor="#f3f4f6", color="#cbd5e1", margin="0.3,0.2", width=10.5, label=<
    <FONT POINT-SIZE="23"><B>Codex Core</B></FONT><BR/><BR/>
    <FONT POINT-SIZE="15">기존 Agent Loop · 모델 추론 · 도구 실행 · 컨텍스트 관리</FONT>
  >];
  external -> bridge;
  bridge -> core;
}
